{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Generator",
  "version": "0.1.3",
  "identifier": "io.github.ddruck12.musicgenerator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "msi",
      "dmg",
      "app"
    ],
    "category": "Music",
    "shortDescription": "Eigene Songs lokal erzeugen",
    "longDescription": "Desktop-App für den lokalen Music Generator: ACE-Step 1.5 über acestep.cpp, ohne Cloud.",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-good"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "wix": {
        "language": [
          "de-DE",
          "en-US"
        ],
        "upgradeCode": "66aefcc8-27f8-4a97-a2d1-7fd8c8123913"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "../../app/": "project/app/",
      "../../static/": "project/static/",
      "../../scripts/common.sh": "project/scripts/common.sh",
      "../../scripts/metal_selftest.py": "project/scripts/metal_selftest.py",
      "../../pyproject.toml": "project/pyproject.toml",
      "../../uv.lock": "project/uv.lock",
      "../../LICENSE": "project/LICENSE"
    }
  }
}
