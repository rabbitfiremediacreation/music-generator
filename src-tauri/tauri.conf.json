{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Generator",
  "version": "0.2.9",
  "identifier": "de.alphatester.music-generator",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Music Generator", "width": 1280, "height": 900,
      "minWidth": 480, "minHeight": 560, "decorations": false, "resizable": true,
      "dragDropEnabled": false, "backgroundColor": "#0c0f14"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost blob:; font-src 'self'; object-src 'none'; base-uri 'self'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": { "resources/engine/": "engine/", "../LICENSE": "LICENSE", "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "26.0", "infoPlist": "Info.plist", "entitlements": "Entitlements.plist" },
    "linux": { "appimage": { "bundleMediaFramework": true } }
  }
}
